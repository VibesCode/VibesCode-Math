def Cnt (n : ℕ) : ℕ := ((primesLE (2 * n)).filter (fun p => p ^ 3 ≤ n ^ 2 + 1)).card

theorem V_eq_zero_of_mod3 {p n : ℕ} (hp : p.Prime) (h3 : p % 4 = 3) : V p n = 0 := by
  unfold V
  apply Finset.sum_eq_zero
  intro k _
  exact padicValNat.eq_zero_of_not_dvd (not_dvd_of_mod_four_eq_three hp h3)

theorem W_bound {n : ℕ} (hn : 1 ≤ n) :
    ∑ p ∈ primesLE (2 * n), (V p n : ℝ) * Real.log p ≤
      ((n : ℝ) + 1) / 2 * Real.log 2 + 2 * n * S1 (2 * n) + Chebyshev.theta (2 * n : ℕ)
        + Chebyshev.theta n + (Cnt n : ℝ) * Real.log ((n : ℝ) ^ 2 + 1) := by
  set P := primesLE (2 * n)
  have h2P : 2 ∈ P := mem_primesLE.mpr ⟨by omega, Nat.prime_two⟩
  -- pointwise bound
  let G : ℕ → ℝ := fun p =>
    (if p = 2 then (V 2 n : ℝ) * Real.log 2 else 0)
    + (if p % 4 = 1 then 2 * n * Real.log p / ((p : ℝ) - 1) else 0)
    + Real.log p + (if p ≤ n then Real.log p else 0)
    + (if p ^ 3 ≤ n ^ 2 + 1 then Real.log ((n : ℝ) ^ 2 + 1) else 0)
  have hlogy : 0 ≤ Real.log ((n : ℝ) ^ 2 + 1) := Real.log_nonneg (by nlinarith)
  have hpt : ∀ p ∈ P, (V p n : ℝ) * Real.log p ≤ G p := by
    intro p hpP
    have hp : p.Prime := (mem_primesLE.mp hpP).2
    have hlp : 0 ≤ Real.log p := Real.log_nonneg (by exact_mod_cast hp.one_lt.le)
    have h4 : 0 ≤ (if p ≤ n then Real.log p else 0) := by split_ifs <;> simp [hlp]
    have h5 : 0 ≤ (if p ^ 3 ≤ n ^ 2 + 1 then Real.log ((n : ℝ) ^ 2 + 1) else 0) := by
      split_ifs <;> simp [hlogy]
    have hd0 : 0 ≤ 2 * n * Real.log p / ((p : ℝ) - 1) := by
      apply div_nonneg (by positivity)
      have : (2 : ℝ) ≤ p := by exact_mod_cast hp.two_le
      linarith
    simp only [G]
    by_cases h2 : p = 2
    · subst h2; rw [if_pos rfl, if_neg (by norm_num : ¬ (2 % 4 = 1))]; push_cast at hlp h4 h5 ⊢; linarith
    · have hodd : p % 2 = 1 := hp.eq_two_or_odd.resolve_left h2
      have hmod : p % 4 = 1 ∨ p % 4 = 3 := by omega
      rcases hmod with h1 | h3
      · obtain ⟨ha, hb, hc⟩ := V_bound hp h1 hn
        simp only [h2, if_false, h1, if_true, zero_add]
        by_cases hpn : p ≤ n
        · simp only [hpn, if_true]
          by_cases hc3 : p ^ 3 ≤ n ^ 2 + 1
          · simp only [hc3, if_true]; linarith
          · simp only [hc3, if_false]
            have := hc (by omega); linarith
        · simp only [hpn, if_false]
          have := hb (by omega)
          linarith
      · rw [V_eq_zero_of_mod3 hp h3]
        simp only [h2, if_false, h3]
        simp
        linarith
  calc ∑ p ∈ P, (V p n : ℝ) * Real.log p ≤ ∑ p ∈ P, G p := Finset.sum_le_sum hpt
    _ = (V 2 n : ℝ) * Real.log 2 + 2 * n * S1 (2 * n)
          + ∑ p ∈ P, Real.log p + ∑ p ∈ P with p ≤ n, Real.log p
          + (Cnt n : ℝ) * Real.log ((n : ℝ) ^ 2 + 1) := by
        simp only [G, Finset.sum_add_distrib, Finset.sum_ite_eq', h2P, if_true]
        congr 1
        congr 1
        congr 1
        · congr 1
          rw [← Finset.sum_filter, S1, Finset.mul_sum]
          refine Finset.sum_congr rfl (fun p _ => by ring)
        · rw [← Finset.sum_filter]
        · rw [← Finset.sum_filter, Finset.sum_const, nsmul_eq_mul, Cnt]
    _ ≤ ((n : ℝ) + 1) / 2 * Real.log 2 + 2 * n * S1 (2 * n) + Chebyshev.theta (2 * n : ℕ)
        + Chebyshev.theta n + (Cnt n : ℝ) * Real.log ((n : ℝ) ^ 2 + 1) := by
        have hV2 := V_two_le n
        have hl2 : 0 ≤ Real.log 2 := Real.log_nonneg (by norm_num)
        have e1 : Chebyshev.theta (2 * n : ℕ) = ∑ p ∈ P, Real.log p := by
          rw [Chebyshev.theta_eq_sum_primesLE_log]
        have e2 : ∑ p ∈ P with p ≤ n, Real.log p ≤ Chebyshev.theta n := by
          rw [Chebyshev.theta_eq_sum_primesLE_log]
          apply Finset.sum_le_sum_of_subset_of_nonneg
          · intro p hp
            simp only [Finset.mem_filter, mem_primesLE, P] at hp ⊢
            exact ⟨hp.2, hp.1.2⟩
          · intro p hp _
            exact Real.log_nonneg (by exact_mod_cast (mem_primesLE.mp hp).2.one_lt.le)
        rw [e1]
        nlinarith [mul_le_mul_of_nonneg_right hV2 hl2]


theorem Cnt_le (n : ℕ) : (Cnt n : ℝ) ≤ ((n : ℝ) ^ 2 + 1) ^ ((1 : ℝ) / 3) := by
  set y : ℝ := ((n : ℝ) ^ 2 + 1) ^ ((1 : ℝ) / 3)
  have hsub : (primesLE (2 * n)).filter (fun p => p ^ 3 ≤ n ^ 2 + 1) ⊆ Icc 1 ⌊y⌋₊ := by
    intro p hp
    simp only [Finset.mem_filter, mem_primesLE] at hp
    simp only [Finset.mem_Icc]
    refine ⟨hp.1.2.one_lt.le, ?_⟩
    apply Nat.le_floor
    have h3 : ((p : ℝ) ^ 3) ≤ (n : ℝ) ^ 2 + 1 := by exact_mod_cast hp.2
    have hp0 : (0 : ℝ) ≤ p := by positivity
    calc (p : ℝ) = ((p : ℝ) ^ (3 : ℝ)) ^ ((1 : ℝ) / 3) := by
          rw [← Real.rpow_mul hp0]; norm_num
      _ ≤ y := by
          apply Real.rpow_le_rpow (by positivity) _ (by norm_num)
          exact_mod_cast h3
  have hy0 : 0 ≤ y := by positivity
  calc (Cnt n : ℝ) ≤ ((Icc 1 ⌊y⌋₊).card : ℝ) := by exact_mod_cast Finset.card_le_card hsub
    _ = (⌊y⌋₊ : ℝ) := by simp
    _ ≤ y := Nat.floor_le hy0

/-- error-term estimate for large n -/
theorem err_le {x : ℝ} (hx : 499950001251 ≤ x) :
    Real.log 2 / 2 + 1 + Real.log (2 * x) / 2 + Real.log (1 + x ^ 2)
      + (x ^ 2 + 1) ^ ((1 : ℝ) / 3) * Real.log (x ^ 2 + 1) ≤ x / 9 := by
  set y := x ^ 2 + 1 with hy
  have hx0 : 0 < x := by linarith
  have hy1 : 1 ≤ y := by nlinarith
  have hy0 : 0 ≤ y := by linarith
  -- log y ≤ 24 y^(1/24)
  have hlog : Real.log y ≤ y ^ ((1 : ℝ) / 24) / (1 / 24) := Real.log_le_rpow_div hy0 (by norm_num)
  -- y^(3/8) ≤ x / 480
  have h38 : y ^ ((3 : ℝ) / 8) ≤ x / 480 := by
    have hyx : y ^ (3 : ℕ) ≤ (x / 480) ^ (8 : ℕ) := by
      have h1 : y ≤ 2 * x ^ 2 := by nlinarith
      have h2 : y ^ 3 ≤ (2 * x ^ 2) ^ 3 := pow_le_pow_left₀ hy0 h1 3
      have h3 : (2 * x ^ 2) ^ 3 ≤ (x / 480) ^ 8 := by
        have hx2 : (8 * 480 ^ 8 : ℝ) ≤ x ^ 2 := by nlinarith
        have : (x / 480) ^ 8 = x ^ 6 * x ^ 2 / 480 ^ 8 := by ring
        rw [this, le_div_iff₀ (by positivity)]
        have hx6 : 0 ≤ x ^ 6 := by positivity
        nlinarith [mul_le_mul_of_nonneg_left hx2 hx6]
      linarith
    have hb : 0 ≤ x / 480 := by positivity
    calc y ^ ((3 : ℝ) / 8) = (y ^ (3 : ℕ)) ^ ((1 : ℝ) / 8) := by
          rw [← Real.rpow_natCast, ← Real.rpow_mul hy0]; norm_num
      _ ≤ ((x / 480) ^ (8 : ℕ)) ^ ((1 : ℝ) / 8) :=
          Real.rpow_le_rpow (by positivity) hyx (by norm_num)
      _ = x / 480 := by
          rw [← Real.rpow_natCast, ← Real.rpow_mul hb]; norm_num
  have hsplit : y ^ ((1 : ℝ) / 3) * y ^ ((1 : ℝ) / 24) = y ^ ((3 : ℝ) / 8) := by
    rw [← Real.rpow_add (by linarith)]; norm_num
  have hmono : y ^ ((1 : ℝ) / 24) ≤ y ^ ((3 : ℝ) / 8) :=
    Real.rpow_le_rpow_of_exponent_le hy1 (by norm_num)
  have hA : y ^ ((1 : ℝ) / 3) * Real.log y ≤ 24 * (x / 480) := by
    have h0 : 0 ≤ y ^ ((1 : ℝ) / 3) := by positivity
    calc y ^ ((1 : ℝ) / 3) * Real.log y ≤ y ^ ((1 : ℝ) / 3) * (y ^ ((1 : ℝ) / 24) / (1 / 24)) :=
          mul_le_mul_of_nonneg_left hlog h0
      _ = 24 * (y ^ ((1 : ℝ) / 3) * y ^ ((1 : ℝ) / 24)) := by ring
      _ ≤ 24 * (x / 480) := by rw [hsplit]; linarith
  have hB : Real.log (1 + x ^ 2) ≤ 24 * (x / 480) := by
    rw [show 1 + x ^ 2 = y by ring]
    have : y ^ ((1 : ℝ) / 24) / (1 / 24) = 24 * y ^ ((1 : ℝ) / 24) := by ring
    linarith
  have hC : Real.log (2 * x) ≤ x / 500 := by
    have h := Real.log_le_rpow_div (show (0 : ℝ) ≤ 2 * x by linarith) (show (0 : ℝ) < 1 / 2 by norm_num)
    have hs : (2 * x) ^ ((1 : ℝ) / 2) ≤ x / 1000 := by
      rw [← Real.sqrt_eq_rpow]
      rw [Real.sqrt_le_left (by positivity)]
      nlinarith
    have : (2 * x) ^ ((1 : ℝ) / 2) / (1 / 2) = 2 * (2 * x) ^ ((1 : ℝ) / 2) := by ring
    linarith
  have hl2 : Real.log 2 < 1 := by
    have := Real.log_two_lt_d9; linarith
  nlinarith


theorem big_prime_unique {n a b q : ℕ} (hq : q.Prime) (hqn : 2 * n < q) (ha : a ∈ Icc 1 n)
    (hb : b ∈ Icc 1 n) (hab : a ≠ b) (hqa : q ∣ 1 + a ^ 2) (hqb : q ∣ 1 + b ^ 2) : False := by
  have hqZ : Prime (q : ℤ) := Nat.prime_iff_prime_int.mp hq
  simp only [Finset.mem_Icc] at ha hb
  have hza : (q : ℤ) ∣ 1 + (a : ℤ) ^ 2 := by exact_mod_cast hqa
  have hzb : (q : ℤ) ∣ 1 + (b : ℤ) ^ 2 := by exact_mod_cast hqb
  have hdiff : (q : ℤ) ∣ ((a : ℤ) - b) * ((a : ℤ) + b) := by
    have := dvd_sub hza hzb
    have e : (1 + (a : ℤ) ^ 2) - (1 + (b : ℤ) ^ 2) = ((a : ℤ) - b) * ((a : ℤ) + b) := by ring
    rwa [e] at this
  rcases hqZ.dvd_or_dvd hdiff with h1 | h1
  · have h := Int.natAbs_dvd_natAbs.mpr h1
    simp at h
    have hpos : 0 < ((a : ℤ) - b).natAbs := by omega
    have := Nat.le_of_dvd hpos h
    omega
  · have h := Int.natAbs_dvd_natAbs.mpr h1
    simp at h
    have hpos : 0 < ((a : ℤ) + b).natAbs := by omega
    have := Nat.le_of_dvd hpos h
    omega

theorem two_primes_large (n : ℕ) (hn : 499950001251 ≤ n) :
    ∃ k₁ k₂ p₁ p₂ : ℕ, p₁.Prime ∧ p₂.Prime ∧ p₁ ≠ p₂ ∧
      2 * n < p₁ ∧ 2 * n < p₂ ∧ k₁ ∈ Icc 1 n ∧ k₂ ∈ Icc 1 n ∧
      (p₁ : ℤ) ∣ 1 + (k₁ : ℤ) ^ 2 ∧ (p₂ : ℤ) ∣ 1 + (k₂ : ℤ) ^ 2 := by
  classical
  set T := (Icc 1 n).filter (fun k => ∃ q, q.Prime ∧ 2 * n < q ∧ q ∣ 1 + k ^ 2) with hTdef
  by_cases hT : 1 < T.card
  · obtain ⟨a, ha, b, hb, hab⟩ := Finset.one_lt_card.mp hT
    simp only [hTdef, Finset.mem_filter] at ha hb
    obtain ⟨haI, q₁, hq₁, hq₁n, hq₁d⟩ := ha
    obtain ⟨hbI, q₂, hq₂, hq₂n, hq₂d⟩ := hb
    have hne : q₁ ≠ q₂ := by
      rintro rfl
      exact big_prime_unique hq₁ hq₁n haI hbI hab hq₁d hq₂d
    exact ⟨a, b, q₁, q₂, hq₁, hq₂, hne, hq₁n, hq₂n, haI, hbI,
      by exact_mod_cast hq₁d, by exact_mod_cast hq₂d⟩
  · exfalso
    push Not at hT
    have hn1 : 1 ≤ n := by omega
    set S := Icc 1 n \ T
    have hTsub : T ⊆ Icc 1 n := Finset.filter_subset _ _
    have hSsub : S ⊆ Icc 1 n := Finset.sdiff_subset
    have hsm : ∀ k ∈ S, ∀ q, q.Prime → q ∣ 1 + k ^ 2 → q ≤ 2 * n := by
      intro k hk q hq hqd
      have hk' : k ∉ T := (Finset.mem_sdiff.mp hk).2
      have hkI := (Finset.mem_sdiff.mp hk).1
      by_contra hc
      apply hk'
      rw [hTdef, Finset.mem_filter]
      exact ⟨hkI, q, hq, by omega, hqd⟩
    have hW := smooth_sum_le S hSsub hsm
    have hsplit : ∑ k ∈ Icc 1 n, Real.log (1 + (k : ℝ) ^ 2)
        = ∑ k ∈ S, Real.log (1 + (k : ℝ) ^ 2) + ∑ k ∈ T, Real.log (1 + (k : ℝ) ^ 2) :=
      (Finset.sum_sdiff hTsub).symm
    have hTle : ∑ k ∈ T, Real.log (1 + (k : ℝ) ^ 2) ≤ Real.log (1 + (n : ℝ) ^ 2) := by
      have hterm : ∀ k ∈ T, Real.log (1 + (k : ℝ) ^ 2) ≤ Real.log (1 + (n : ℝ) ^ 2) := by
        intro k hk
        have hkI := hTsub hk
        simp only [Finset.mem_Icc] at hkI
        apply Real.log_le_log (by positivity)
        have : (k : ℝ) ≤ n := by exact_mod_cast hkI.2
        have : (0 : ℝ) ≤ k := by positivity
        nlinarith
      have h0 : 0 ≤ Real.log (1 + (n : ℝ) ^ 2) := Real.log_nonneg (by nlinarith)
      calc ∑ k ∈ T, Real.log (1 + (k : ℝ) ^ 2) ≤ ∑ k ∈ T, Real.log (1 + (n : ℝ) ^ 2) :=
            Finset.sum_le_sum hterm
        _ = T.card * Real.log (1 + (n : ℝ) ^ 2) := by simp
        _ ≤ 1 * Real.log (1 + (n : ℝ) ^ 2) := by
            apply mul_le_mul_of_nonneg_right _ h0; exact_mod_cast hT
        _ = _ := one_mul _
    have hfac := two_log_factorial_le n
    have hWb := W_bound hn1
    -- facts
    have hx : (499950001251 : ℝ) ≤ n := by exact_mod_cast hn
    have hnpos : (0 : ℝ) < n := by linarith
    have hlogn : 0 ≤ Real.log n := Real.log_nonneg (by linarith)
    have F1 : (n : ℝ) * Real.log n - n ≤ Real.log (n ! : ℝ) := by
      have := Stirling.le_log_factorial_stirling (n := n) (by omega)
      have h2pi : 0 ≤ Real.log (2 * π) := Real.log_nonneg (by nlinarith [Real.pi_gt_three])
      linarith
    have hS1 := S1_le (2 * n)
    have hL3 : Real.log 2 * (6785251938 / 10 ^ 9) ≤ L3 (2 * n) :=
      L3_ge.trans (L3_mono (by omega))
    have hT1 := T1_le (2 * n)
    have hL := mul_L_le (2 * n)
    have hfac2 := log_factorial_le (m := 2 * n) (by omega)
    have hth2 := Chebyshev.theta_le_log4_mul_x (x := ((2 * n : ℕ) : ℝ)) (by positivity)
    have hth1 := Chebyshev.theta_le_log4_mul_x (x := (n : ℝ)) (by positivity)
    have hlog4 : Real.log 4 = 2 * Real.log 2 := by
      rw [show (4 : ℝ) = 2 ^ 2 by norm_num, Real.log_pow]; norm_num
    have hlog2n : Real.log ((2 * n : ℕ) : ℝ) = Real.log 2 + Real.log n := by
      push_cast; exact Real.log_mul (by norm_num) (by linarith)
    have hC := Cnt_le n
    have hly : 0 ≤ Real.log ((n : ℝ) ^ 2 + 1) := Real.log_nonneg (by nlinarith)
    have hCl := mul_le_mul_of_nonneg_right hC hly
    have herr := err_le hx
    have hl2a := Real.log_two_gt_d9
    have hl2b := Real.log_two_lt_d9
    push_cast at hL hfac2 hth2 hWb hlog2n
    rw [hlog2n] at hfac2
    -- products with n
    have P1 := mul_le_mul_of_nonneg_left hS1 (show (0 : ℝ) ≤ 2 * n by positivity)
    have P2 := mul_le_mul_of_nonneg_left hL3 (show (0 : ℝ) ≤ 2 * n by positivity)
    have P3 := mul_le_mul_of_nonneg_left hT1 (show (0 : ℝ) ≤ 2 * n by positivity)
    have P4 := mul_le_mul_of_nonneg_left hl2a.le (show (0 : ℝ) ≤ n by positivity)
    have e1 : Real.log (1 + (n : ℝ) ^ 2) = Real.log ((n : ℝ) ^ 2 + 1) := by ring_nf
    rw [hlog4] at hth2 hth1
    nlinarith

end TanH
end TanHSec

section ReductionSec

/-!
Reduction for tan(arctan 1 + ... + arctan n).
Reduction: if two distinct primes p₁, p₂ > 2n divide 1 + k₁², 1 + k₂² for some k₁, k₂ ∈ [1, n],
then an integer value x_n = m has |m| ≥ 2n + 2, hence n is in Ono's exceptional set E
(formal-conjectures' `exceptional`).
-/

open Finset Arxiv.«2607.05739»

namespace TwoPrimes

lemma norm_gen (k : ℕ) : (⟨1, (k : ℤ)⟩ : GaussianInt).norm = 1 + (k : ℤ) ^ 2 := by
  simp [Zsqrtd.norm_def]; ring

lemma sq_add_sq (n : ℕ) : (A n) ^ 2 + (B n) ^ 2 = ∏ k ∈ Icc 1 n, (1 + (k : ℤ) ^ 2) := by
  have h : (gaussProd n).norm = ∏ k ∈ Icc 1 n, (⟨1, (k : ℤ)⟩ : GaussianInt).norm := by
    unfold gaussProd
    exact map_prod Zsqrtd.normMonoidHom _ _
  rw [Zsqrtd.norm_def] at h
  simp only [norm_gen] at h
  simp only [A, B]
  have : (-1 : ℤ) = (-1 : ℤ) := rfl
  linear_combination h

/-- A prime p > 2n dividing 1 + k₀² (k₀ ≤ n) divides no other 1 + k², k ≤ n,
and p² does not divide the product. -/
lemma not_sq_dvd {n k₀ p : ℕ} (hp : p.Prime) (hpn : 2 * n < p) (hk : k₀ ∈ Icc 1 n)
    (hd : (p : ℤ) ∣ 1 + (k₀ : ℤ) ^ 2) :
    ¬ ((p : ℤ) ^ 2 ∣ ∏ k ∈ Icc 1 n, (1 + (k : ℤ) ^ 2)) := by
  have hpZ : Prime (p : ℤ) := Nat.prime_iff_prime_int.mp hp
  rw [← Finset.mul_prod_erase _ _ hk]
  have hrest : ¬ (p : ℤ) ∣ ∏ k ∈ (Icc 1 n).erase k₀, (1 + (k : ℤ) ^ 2) := by
    intro h
    obtain ⟨k, hkmem, hkd⟩ := (Prime.dvd_finsetProd_iff hpZ _).mp h
    have hne : k ≠ k₀ := Finset.ne_of_mem_erase hkmem
    have hkI := Finset.mem_of_mem_erase hkmem
    simp only [Finset.mem_Icc] at hk hkI
    have hdiff : (p : ℤ) ∣ ((k : ℤ) - k₀) * ((k : ℤ) + k₀) := by
      have := dvd_sub hkd hd
      have e : (1 + (k : ℤ) ^ 2) - (1 + (k₀ : ℤ) ^ 2) = ((k : ℤ) - k₀) * ((k : ℤ) + k₀) := by ring
      rwa [e] at this
    rcases hpZ.dvd_or_dvd hdiff with h1 | h1
    · -- 0 < |k - k₀| < p
      have hlt : ((k : ℤ) - k₀).natAbs < p := by omega
      have hpos : 0 < ((k : ℤ) - k₀).natAbs := by omega
      have := Int.natAbs_dvd_natAbs.mpr h1
      simp at this
      exact absurd (Nat.le_of_dvd hpos this) (by omega)
    · have hlt : ((k : ℤ) + k₀).natAbs < p := by omega
      have hpos : 0 < ((k : ℤ) + k₀).natAbs := by omega
      have := Int.natAbs_dvd_natAbs.mpr h1
      simp at this
      exact absurd (Nat.le_of_dvd hpos this) (by omega)
  intro h
  have hcop : IsCoprime ((p : ℤ) ^ 2) (∏ k ∈ (Icc 1 n).erase k₀, (1 + (k : ℤ) ^ 2)) := by
    apply IsCoprime.pow_left
    exact (Prime.coprime_iff_not_dvd hpZ).mpr hrest
  have h2 : (p : ℤ) ^ 2 ∣ 1 + (k₀ : ℤ) ^ 2 := hcop.dvd_of_dvd_mul_right h
  have hpos : (0 : ℤ) < 1 + (k₀ : ℤ) ^ 2 := by positivity
  have hle := Int.le_of_dvd hpos h2
  simp only [Finset.mem_Icc] at hk
  have : (k₀ : ℤ) ≤ n := by exact_mod_cast hk.2
  have : (2 * n + 1 : ℤ) ≤ p := by exact_mod_cast hpn
  nlinarith

/-- Such a prime divides 1 + m² whenever B n = m · A n. -/
lemma dvd_one_add_sq {n k₀ p : ℕ} (hp : p.Prime) (hpn : 2 * n < p) (hk : k₀ ∈ Icc 1 n)
    (hd : (p : ℤ) ∣ 1 + (k₀ : ℤ) ^ 2) {m : ℤ} (hm : B n = A n * m) :
    (p : ℤ) ∣ 1 + m ^ 2 := by
  have hpZ : Prime (p : ℤ) := Nat.prime_iff_prime_int.mp hp
  have hω : ∏ k ∈ Icc 1 n, (1 + (k : ℤ) ^ 2) = (A n) ^ 2 * (1 + m ^ 2) := by
    rw [← sq_add_sq, hm]; ring
  have hns := not_sq_dvd hp hpn hk hd
  rw [hω] at hns
  have hdω : (p : ℤ) ∣ (A n) ^ 2 * (1 + m ^ 2) := by
    rw [← hω]
    exact hd.trans (Finset.dvd_prod_of_mem _ hk)
  rcases hpZ.dvd_or_dvd hdω with h | h
  · exfalso; apply hns
    have := hpZ.dvd_of_dvd_pow h
    exact (pow_dvd_pow_of_dvd this 2).mul_right _
  · exact h

/-- The reduction. -/
theorem mem_exceptional_of_two_primes {n k₁ k₂ p₁ p₂ : ℕ} (hn : 5 ≤ n)
    (hp₁ : p₁.Prime) (hp₂ : p₂.Prime) (hne : p₁ ≠ p₂)
    (h₁ : 2 * n < p₁) (h₂ : 2 * n < p₂) (hk₁ : k₁ ∈ Icc 1 n) (hk₂ : k₂ ∈ Icc 1 n)
    (hd₁ : (p₁ : ℤ) ∣ 1 + (k₁ : ℤ) ^ 2) (hd₂ : (p₂ : ℤ) ∣ 1 + (k₂ : ℤ) ^ 2)
    (hI : IsIntegerValue n) :
    n ∈ exceptional ∧ (A n ≠ 0 → ((2 * n + 2 : ℕ) : ℚ) ≤ |x n|) := by
  obtain ⟨m, hm⟩ := hI
  have d₁ := dvd_one_add_sq hp₁ h₁ hk₁ hd₁ hm
  have d₂ := dvd_one_add_sq hp₂ h₂ hk₂ hd₂ hm
  have hcop : IsCoprime (p₁ : ℤ) (p₂ : ℤ) := by
    rw [Int.isCoprime_iff_gcd_eq_one, Int.gcd_natCast_natCast]
    exact (Nat.coprime_primes hp₁ hp₂).mpr hne
  have d12 : (p₁ : ℤ) * p₂ ∣ 1 + m ^ 2 := hcop.mul_dvd d₁ d₂
  have hle := Int.le_of_dvd (by positivity) d12
  -- p₁ p₂ ≥ (2n+1)(2n+2)
  have hbig : ((2 * n + 1) * (2 * n + 2) : ℤ) ≤ (p₁ : ℤ) * p₂ := by
    rcases lt_or_gt_of_ne hne with h | h
    · have a : (2 * n + 1 : ℤ) ≤ p₁ := by exact_mod_cast h₁
      have b : (2 * n + 2 : ℤ) ≤ p₂ := by exact_mod_cast (show 2 * n + 2 ≤ p₂ by omega)
      nlinarith
    · have a : (2 * n + 1 : ℤ) ≤ p₂ := by exact_mod_cast h₂
      have b : (2 * n + 2 : ℤ) ≤ p₁ := by exact_mod_cast (show 2 * n + 2 ≤ p₁ by omega)
      nlinarith
  have hmabs : (2 * n + 2 : ℤ) ≤ |m| := by
    by_contra hc
    push Not at hc
    have h0 : 0 ≤ |m| := abs_nonneg m
    have : |m| ≤ 2 * n + 1 := by omega
    have : m ^ 2 ≤ (2 * n + 1) ^ 2 := by
      rw [← sq_abs]; exact pow_le_pow_left₀ h0 this 2
    nlinarith
  have key : A n ≠ 0 → ((2 * n + 2 : ℕ) : ℚ) ≤ |x n| := by
    intro hA
    have hx : x n = (m : ℚ) := by
      unfold x; rw [hm]; push_cast; field_simp
    rw [hx]
    have : ((2 * n + 2 : ℤ) : ℚ) ≤ ((|m| : ℤ) : ℚ) := by exact_mod_cast hmabs
    push_cast at this ⊢; exact this
  refine ⟨⟨hn, ?_⟩, key⟩
  by_cases hA : A n = 0
  · exact Or.inl hA
  · right
    have := key hA
    push_cast at this
    have hn' : (0 : ℚ) ≤ n := by positivity
    linarith

end TwoPrimes

namespace Certs

lemma mem_of_dvd_prod {q : ℕ} (hq : q.Prime) : ∀ l : List ℕ, (∀ r ∈ l, r.Prime) → q ∣ l.prod → q ∈ l
  | [], _, h => by simp at h; exact absurd h hq.one_lt.ne'
  | r :: l, hl, h => by
    rw [List.prod_cons] at h
    rcases (Nat.Prime.dvd_mul hq).mp h with h1 | h1
    · have := (Nat.prime_dvd_prime_iff_eq hq (hl r (by simp))).mp h1
      simp [this]
    · exact List.mem_cons_of_mem _ (mem_of_dvd_prod hq l (fun r hr => hl r (by simp [hr])) h1)

lemma mem_of_dvd_sq {q m : ℕ} (l : List ℕ) (hq : q.Prime) (h : q ∣ m) (hm : m = l.prod ^ 2)
    (hlp : ∀ r ∈ l, r.Prime) : q ∈ l :=
  mem_of_dvd_prod hq l hlp (hq.dvd_of_dvd_pow (hm ▸ h))


