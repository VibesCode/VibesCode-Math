module

public import Mathlib

@[expose] public section

open Finset

namespace Arxiv.«2607.05739»

/-- $Z_n = \prod_{k=1}^n (1 + ik)$, in the Gaussian integers. -/
def gaussProd (n : ℕ) : GaussianInt := ∏ k ∈ Finset.Icc 1 n, (⟨1, (k : ℤ)⟩ : GaussianInt)

/-- $A_n = \operatorname{Re} Z_n$. -/
def A (n : ℕ) : ℤ := (gaussProd n).re

/-- $B_n = \operatorname{Im} Z_n$. -/
def B (n : ℕ) : ℤ := (gaussProd n).im

/-- $x_n = \tan\left(\sum_{k=1}^n \arctan k\right) = B_n / A_n$. -/
noncomputable def x (n : ℕ) : ℚ := (B n : ℚ) / (A n : ℚ)

/-- $x_n$ takes an integer value.

Stated as $A_n \mid B_n$ rather than as `∃ m : ℤ, x n = m`, so that it still says the right
thing if $A_n$ were ever $0$. There $x_n$ is a pole of the tangent rather than an integer, but
`(B n : ℚ) / 0` is `0` in Lean and would count as one. The two agree whenever $A_n \neq 0$,
which holds for every $n \leq 3000$. -/
def IsIntegerValue (n : ℕ) : Prop := A n ∣ B n

instance (n : ℕ) : Decidable (IsIntegerValue n) := by unfold IsIntegerValue; infer_instance

/-- The exceptional set $E = \{n \geq 5 : |x_n| > n/2 + 1\}$. An index with $A_n = 0$ is a
pole of the tangent rather than a large value, and is counted in, reading $|x_n|$ as infinite. -/
def exceptional : Set ℕ := {n | 5 ≤ n ∧ (A n = 0 ∨ ((n : ℚ) / 2 + 1 < |x n|))}


end Arxiv.«2607.05739»


/-!
# Explicit form of Ono's Corollary 1.2 for x_n = tan(arctan 1 + ⋯ + arctan n)

For every n ≥ 5, an integer value of x_n forces n ∈ E (formal-conjectures' `exceptional`).
* `TwoPrimes`: two distinct primes p > 2n dividing 1 + k², k ≤ n, force |x_n| ≥ 2n + 2, so n ∈ E.
* `Certs`: 12 explicit prime certificates cover 5 ≤ n ≤ 499950001250.
* `TanH`: for n ≥ 499950001251 such two primes exist (Chebyshev-type argument: valuation counting,
  Stirling, Mathlib's θ(x) ≤ x log 4, and a certified lower bound for the sum of log p / p over primes p ≤ 20000, p ≢ 1 mod 4).
-/

section TanHSec
open Finset Nat Real
open Real (log)

namespace TanH
noncomputable def L (m : ℕ) : ℝ := ∑ p ∈ primesLE m, Real.log p / p
noncomputable def S1 (m : ℕ) : ℝ := ∑ p ∈ primesLE m with p % 4 = 1, Real.log p / ((p : ℝ) - 1)
noncomputable def L3 (m : ℕ) : ℝ := ∑ p ∈ primesLE m with p % 4 ≠ 1, Real.log p / p
noncomputable def T1 (m : ℕ) : ℝ := ∑ p ∈ primesLE m with p % 4 = 1, Real.log p / ((p : ℝ) * ((p : ℝ) - 1))
def V (p n : ℕ) : ℕ := ∑ k ∈ Icc 1 n, padicValNat p (1 + k ^ 2)

/-! ### Group A: valuation counting -/

lemma val2_le (k : ℕ) : padicValNat 2 (1 + k ^ 2) ≤ k % 2 := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  rcases Nat.even_or_odd' k with ⟨m, rfl | rfl⟩
  · have h : ¬ 2 ∣ 1 + (2 * m) ^ 2 := by
      intro h
      have : (2 * m) ^ 2 = 2 * (2 * m ^ 2) := by ring
      omega
    rw [padicValNat.eq_zero_of_not_dvd h]
    exact Nat.zero_le _
  · have h : ¬ 2 ^ 2 ∣ 1 + (2 * m + 1) ^ 2 := by
      intro h
      have : (2 * m + 1) ^ 2 = 4 * (m ^ 2 + m) + 1 := by ring
      norm_num at h
      omega
    have h2 : padicValNat 2 (1 + (2 * m + 1) ^ 2) < 2 := by
      by_contra hc
      push_neg at hc
      exact h ((padicValNat_dvd_iff_le (by positivity)).mpr hc)
    omega

lemma sum_mod_two (n : ℕ) : ∑ k ∈ Icc 1 n, k % 2 = (n + 1) / 2 := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [Finset.sum_Icc_succ_top (by omega), ih]
    omega

lemma two_roots {p j : ℕ} (hp : p.Prime) (hp1 : p % 4 = 1) (hj : 1 ≤ j) {x y : ℤ}
    (hx : (p : ℤ) ^ j ∣ 1 + x ^ 2) (hy : (p : ℤ) ^ j ∣ 1 + y ^ 2) :
    (p : ℤ) ^ j ∣ x - y ∨ (p : ℤ) ^ j ∣ x + y := by
  have hpz : Prime (p : ℤ) := Nat.prime_iff_prime_int.mp hp
  have hmul : (p : ℤ) ^ j ∣ (x - y) * (x + y) := by
    have : (x - y) * (x + y) = (1 + x ^ 2) - (1 + y ^ 2) := by ring
    rw [this]; exact dvd_sub hx hy
  by_cases h1 : (p : ℤ) ∣ x - y
  · by_cases h2 : (p : ℤ) ∣ x + y
    · exfalso
      have h2x : (p : ℤ) ∣ 2 * x := by
        have e : 2 * x = (x - y) + (x + y) := by ring
        rw [e]; exact dvd_add h1 h2
      rcases hpz.dvd_or_dvd h2x with h | h
      · have h' : p ∣ 2 := by exact_mod_cast h
        have := Nat.le_of_dvd (by norm_num) h'
        have := hp.two_le
        omega
      · have h3 : (p : ℤ) ∣ 1 + x ^ 2 := dvd_trans (dvd_pow_self _ (by omega)) hx
        have h4 : (p : ℤ) ∣ x ^ 2 := dvd_pow h (by norm_num)
        have h5 := dvd_sub h3 h4
        simp at h5
        exact hpz.not_dvd_one h5
    · left
      exact hpz.pow_dvd_of_dvd_mul_right j h2 hmul
  · right
    exact hpz.pow_dvd_of_dvd_mul_left j h1 hmul

lemma count_le {p j n : ℕ} (hp : p.Prime) (hp1 : p % 4 = 1) (hj : 1 ≤ j) :
    ((((Icc 1 n).filter (fun k => p ^ j ∣ 1 + k ^ 2)).card : ℕ) : ℝ) ≤ 2 * n / ((p : ℝ) ^ j) + 1 := by
  set S := (Icc 1 n).filter (fun k => p ^ j ∣ 1 + k ^ 2) with hS
  have hq : 0 < p ^ j := pow_pos hp.pos j
  have hqR : (0 : ℝ) < (p : ℝ) ^ j := pow_pos (by exact_mod_cast hp.pos) j
  rcases S.eq_empty_or_nonempty with he | ⟨k₀, hk₀⟩
  · rw [he]; simp only [card_empty, Nat.cast_zero]; positivity
  have hmem : ∀ k ∈ S, 1 ≤ k ∧ k ≤ n ∧ ((p ^ j : ℕ) : ℤ) ∣ 1 + (k : ℤ) ^ 2 := by
    intro k hk
    rw [hS, mem_filter, mem_Icc] at hk
    refine ⟨hk.1.1, hk.1.2, ?_⟩
    exact_mod_cast hk.2
  have key : ∀ k ∈ S, ((p ^ j : ℕ) : ℤ) ∣ ((if ((p ^ j : ℕ) : ℤ) ∣ (k : ℤ) - k₀ then (k : ℤ) else -(k : ℤ)) - k₀) := by
    intro k hk
    split_ifs with h
    · exact h
    · have := two_roots hp hp1 hj (x := (k : ℤ)) (y := (k₀ : ℤ))
        (by have := (hmem k hk).2.2; push_cast at this; exact this)
        (by have := (hmem k₀ hk₀).2.2; push_cast at this; exact this)
      push_cast at h
      rcases this with h' | h'
      · exact absurd h' h
      · have : -(k : ℤ) - k₀ = -((k : ℤ) + k₀) := by ring
        rw [this]; push_cast; exact (dvd_neg).mpr h'
  have bnd : ∀ k ∈ S, -(n : ℤ) ≤ (if ((p ^ j : ℕ) : ℤ) ∣ (k : ℤ) - k₀ then (k : ℤ) else -(k : ℤ)) ∧
      (if ((p ^ j : ℕ) : ℤ) ∣ (k : ℤ) - k₀ then (k : ℤ) else -(k : ℤ)) ≤ n := by
    intro k hk
    have := hmem k hk
    split_ifs <;> omega
  have hqZ : (0 : ℤ) < ((p ^ j : ℕ) : ℤ) := by exact_mod_cast hq
  have hcard : S.card ≤ (Finset.Icc (0 : ℤ) ((2 * n : ℤ) / ((p ^ j : ℕ) : ℤ))).card := by
    apply Finset.card_le_card_of_injOn
      (fun k : ℕ => ((if ((p ^ j : ℕ) : ℤ) ∣ (k : ℤ) - k₀ then (k : ℤ) else -(k : ℤ)) + n) / ((p ^ j : ℕ) : ℤ))
    · intro k hk
      have hk' : k ∈ S := hk
      have := bnd k hk'
      simp only [Finset.coe_Icc, Set.mem_Icc]
      constructor
      · exact Int.ediv_nonneg (by omega) hqZ.le
      · exact Int.ediv_le_ediv hqZ (by omega)
    · intro k hk k' hk' heq
      have hk1 : k ∈ S := hk
      have hk2 : k' ∈ S := hk'
      simp only at heq
      set a := (if ((p ^ j : ℕ) : ℤ) ∣ (k : ℤ) - k₀ then (k : ℤ) else -(k : ℤ)) with ha
      set b := (if ((p ^ j : ℕ) : ℤ) ∣ (k' : ℤ) - k₀ then (k' : ℤ) else -(k' : ℤ)) with hb
      have d1 := key k hk1
      have d2 := key k' hk2
      rw [← ha] at d1
      rw [← hb] at d2
      have hmod : (a + n) % ((p ^ j : ℕ) : ℤ) = (b + n) % ((p ^ j : ℕ) : ℤ) := by
        have : Int.ModEq ((p ^ j : ℕ) : ℤ) (b + n) (a + n) := by
          rw [Int.modEq_iff_dvd]
          have e : (a + n) - (b + n) = (a - k₀) - (b - k₀) := by ring
          rw [e]; exact dvd_sub d1 d2
        exact this.symm
      have e1 := Int.mul_ediv_add_emod (a + n) ((p ^ j : ℕ) : ℤ)
      have e2 := Int.mul_ediv_add_emod (b + n) ((p ^ j : ℕ) : ℤ)
      rw [heq, hmod] at e1
      have hab : a = b := by linarith
      have b1 := hmem k hk1
      have b2 := hmem k' hk2
      rw [ha, hb] at hab
      split_ifs at hab <;> omega
  have hc2 : (Finset.Icc (0 : ℤ) ((2 * n : ℤ) / ((p ^ j : ℕ) : ℤ))).card = 2 * n / p ^ j + 1 := by
    rw [Int.card_Icc]
    have : ((2 * n : ℤ) / ((p ^ j : ℕ) : ℤ)) = ((2 * n / p ^ j : ℕ) : ℤ) := by
      norm_cast
    rw [this]; generalize 2 * n / p ^ j = x; omega
  have h3 : S.card ≤ 2 * n / p ^ j + 1 := hcard.trans hc2.le
  have h4 : ((2 * n / p ^ j : ℕ) : ℝ) ≤ (2 * n : ℝ) / (p : ℝ) ^ j := by
    have := Nat.cast_div_le (α := ℝ) (m := 2 * n) (n := p ^ j)
    push_cast at this; exact this
  calc (S.card : ℝ) ≤ ((2 * n / p ^ j + 1 : ℕ) : ℝ) := by exact_mod_cast h3
    _ ≤ _ := by push_cast; linarith

lemma val_eq_card {p m M : ℕ} (hp : p.Prime) (hm : m ≠ 0) (hM : padicValNat p m ≤ M) :
    padicValNat p m = ((Icc 1 M).filter (fun j => p ^ j ∣ m)).card := by
  haveI := Fact.mk hp
  have : (Icc 1 M).filter (fun j => p ^ j ∣ m) = Icc 1 (padicValNat p m) := by
    ext j
    simp only [mem_filter, mem_Icc]
    constructor
    · rintro ⟨⟨h1, h2⟩, h3⟩
      exact ⟨h1, (padicValNat_dvd_iff_le hm).mp h3⟩
    · rintro ⟨h1, h2⟩
      exact ⟨⟨h1, h2.trans hM⟩, (padicValNat_dvd_iff_le hm).mpr h2⟩
  rw [this]; simp

lemma V_eq {p : ℕ} (hp : p.Prime) (n : ℕ) :
    V p n = ∑ j ∈ Icc 1 (n ^ 2 + 1), ((Icc 1 n).filter (fun k => p ^ j ∣ 1 + k ^ 2)).card := by
  haveI := Fact.mk hp
  unfold V
  have h : ∀ k ∈ Icc 1 n, padicValNat p (1 + k ^ 2) =
      ((Icc 1 (n ^ 2 + 1)).filter (fun j => p ^ j ∣ 1 + k ^ 2)).card := by
    intro k hk
    rw [mem_Icc] at hk
    apply val_eq_card hp (by positivity)
    have h1 : p ^ (padicValNat p (1 + k ^ 2)) ∣ 1 + k ^ 2 := pow_padicValNat_dvd
    have h2 := Nat.le_of_dvd (by positivity) h1
    have h3 : padicValNat p (1 + k ^ 2) < p ^ (padicValNat p (1 + k ^ 2)) := Nat.lt_pow_self hp.one_lt
    have : k ^ 2 ≤ n ^ 2 := Nat.pow_le_pow_left hk.2 2
    omega
  rw [sum_congr rfl h]
  simp only [card_filter]
  exact sum_comm

lemma geom_aux {p : ℕ} (hp : p.Prime) (m : ℕ) :
    ((p : ℝ) - 1) * (∑ j ∈ Icc 1 m, 1 / (p : ℝ) ^ j) + 1 / (p : ℝ) ^ m = 1 := by
  have hp0 : (p : ℝ) ≠ 0 := by exact_mod_cast hp.ne_zero
  induction m with
  | zero => simp
  | succ m ih =>
    rw [Finset.sum_Icc_succ_top (by omega), mul_add]
    have : 1 / (p : ℝ) ^ (m + 1) * ((p : ℝ) - 1) + 1 / (p : ℝ) ^ (m + 1)
        = 1 / (p : ℝ) ^ m := by
      field_simp
      ring
    linarith

lemma V_main {p n : ℕ} (hp : p.Prime) (hp1 : p % 4 = 1) (hn : 1 ≤ n) :
    (V p n : ℝ) ≤ 2 * n / ((p : ℝ) - 1) + (Nat.log p (n ^ 2 + 1) : ℕ) := by
  set m := Nat.log p (n ^ 2 + 1) with hm
  have hp2 := hp.two_le
  have hmM : m ≤ n ^ 2 + 1 := by
    have := Nat.log_le_self p (n ^ 2 + 1)
    exact this
  have hsub : (Icc 1 m) ⊆ Icc 1 (n ^ 2 + 1) := Finset.Icc_subset_Icc le_rfl hmM
  have hV : V p n = ∑ j ∈ Icc 1 m, ((Icc 1 n).filter (fun k => p ^ j ∣ 1 + k ^ 2)).card := by
    rw [V_eq hp n]
    symm
    apply Finset.sum_subset hsub
    intro j hj hjn
    rw [mem_Icc] at hj hjn
    have hjm : m < j := by
      by_contra hc
      exact hjn ⟨hj.1, by omega⟩
    have h1 : n ^ 2 + 1 < p ^ j := by
      have := Nat.lt_pow_succ_log_self hp.one_lt (n ^ 2 + 1)
      exact this.trans_le (Nat.pow_le_pow_right hp.pos hjm)
    rw [Finset.card_eq_zero, Finset.filter_eq_empty_iff]
    intro k hk hd
    rw [mem_Icc] at hk
    have := Nat.le_of_dvd (by positivity) hd
    have : k ^ 2 ≤ n ^ 2 := Nat.pow_le_pow_left hk.2 2
    omega
  have hp1R : (1 : ℝ) < p := by exact_mod_cast hp.one_lt
  have hgeom := geom_aux hp m
  have hs : (∑ j ∈ Icc 1 m, 1 / (p : ℝ) ^ j) ≤ 1 / ((p : ℝ) - 1) := by
    rw [le_div_iff₀ (by linarith)]
    have : 0 ≤ 1 / (p : ℝ) ^ m := by positivity
    nlinarith
  have hsum : (V p n : ℝ) ≤ ∑ j ∈ Icc 1 m, (2 * n * (1 / (p : ℝ) ^ j) + 1) := by
    rw [hV]
    push_cast
    apply Finset.sum_le_sum
    intro j hj
    rw [mem_Icc] at hj
    have := count_le (n := n) hp hp1 hj.1
    calc _ ≤ _ := this
      _ = _ := by ring
  have : ∑ j ∈ Icc 1 m, (2 * (n : ℝ) * (1 / (p : ℝ) ^ j) + 1)
      = 2 * n * (∑ j ∈ Icc 1 m, 1 / (p : ℝ) ^ j) + m := by
    rw [Finset.sum_add_distrib, ← Finset.mul_sum]; simp
  rw [this] at hsum
  have hn0 : (0 : ℝ) ≤ 2 * n := by positivity
  calc (V p n : ℝ) ≤ _ := hsum
    _ ≤ 2 * n * (1 / ((p : ℝ) - 1)) + m := by gcongr
    _ = _ := by ring

lemma log_le {p n : ℕ} (hp : p.Prime) (hn : 1 ≤ n) :
    ((Nat.log p (n ^ 2 + 1) : ℕ) : ℝ) * Real.log p ≤ Real.log ((n : ℝ) ^ 2 + 1) := by
  have h1 : p ^ (Nat.log p (n ^ 2 + 1)) ≤ n ^ 2 + 1 := Nat.pow_log_le_self p (by positivity)
  have h2 : ((p : ℝ)) ^ (Nat.log p (n ^ 2 + 1)) ≤ (n : ℝ) ^ 2 + 1 := by exact_mod_cast h1
  have hp0 : (0 : ℝ) < p := by exact_mod_cast hp.pos
  rw [← Real.log_pow]
  exact Real.log_le_log (by positivity) h2

theorem not_dvd_of_mod_four_eq_three {p k : ℕ} (hp : p.Prime) (h3 : p % 4 = 3) : ¬ p ∣ 1 + k ^ 2 := by
  intro h
  haveI := Fact.mk hp
  have h0 : ((1 + k ^ 2 : ℕ) : ZMod p) = 0 := (ZMod.natCast_eq_zero_iff _ _).mpr h
  push_cast at h0
  have hsq : IsSquare (-1 : ZMod p) := ⟨k, by linear_combination (-1 : ZMod p) * h0⟩
  have := (ZMod.exists_sq_eq_neg_one_iff (p := p)).mp hsq
  omega
theorem V_two_le (n : ℕ) : (V 2 n : ℝ) ≤ ((n : ℝ) + 1) / 2 := by
  have h1 : V 2 n ≤ ∑ k ∈ Icc 1 n, k % 2 := Finset.sum_le_sum (fun k _ => val2_le k)
  rw [sum_mod_two] at h1
  have h2 : ((V 2 n : ℕ) : ℝ) ≤ (((n + 1) / 2 : ℕ) : ℝ) := by exact_mod_cast h1
  have h3 := Nat.cast_div_le (α := ℝ) (m := n + 1) (n := 2)
  push_cast at h3
  exact h2.trans h3
/-- For p ≡ 1 mod 4 prime: V_p Real.log p ≤ 2n Real.log p/(p-1) + log(n²+1); refinements when p > n or p³ > n²+1. -/
theorem V_bound {p n : ℕ} (hp : p.Prime) (hp1 : p % 4 = 1) (hn : 1 ≤ n) :
    (V p n : ℝ) * Real.log p ≤ 2 * n * Real.log p / ((p : ℝ) - 1) + Real.log ((n : ℝ) ^ 2 + 1) ∧
    (n < p → (V p n : ℝ) * Real.log p ≤ 2 * n * Real.log p / ((p : ℝ) - 1) + Real.log p) ∧
    (n ^ 2 + 1 < p ^ 3 → (V p n : ℝ) * Real.log p ≤ 2 * n * Real.log p / ((p : ℝ) - 1) + 2 * Real.log p) := by
  have hmain := V_main hp hp1 hn
  have hl := log_le hp hn
  have hlp : 0 ≤ Real.log p := Real.log_nonneg (by exact_mod_cast hp.one_lt.le)
  have hp2 := hp.two_le
  have base : (V p n : ℝ) * Real.log p ≤ 2 * n * Real.log p / ((p : ℝ) - 1)
      + ((Nat.log p (n ^ 2 + 1) : ℕ) : ℝ) * Real.log p := by
    have := mul_le_mul_of_nonneg_right hmain hlp
    calc _ ≤ _ := this
      _ = _ := by ring
  refine ⟨base.trans (by linarith), ?_, ?_⟩
  · intro hnp
    have : Nat.log p (n ^ 2 + 1) < 2 := by
      apply Nat.log_lt_of_lt_pow (by positivity)
      nlinarith
    have hm : ((Nat.log p (n ^ 2 + 1) : ℕ) : ℝ) ≤ 1 := by exact_mod_cast (by omega : Nat.log p (n ^ 2 + 1) ≤ 1)
    nlinarith
  · intro h3
    have : Nat.log p (n ^ 2 + 1) < 3 := Nat.log_lt_of_lt_pow (by positivity) h3
    have hm : ((Nat.log p (n ^ 2 + 1) : ℕ) : ℝ) ≤ 2 := by exact_mod_cast (by omega : Nat.log p (n ^ 2 + 1) ≤ 2)
    nlinarith


/-! ### Group B: smooth part and factorial bounds -/

lemma log_eq_sum_primesLE (N M : ℕ) (hN : N ≠ 0) (h : ∀ q, q.Prime → q ∣ N → q ≤ M) :
    Real.log N = ∑ p ∈ primesLE M, (padicValNat p N : ℝ) * Real.log p := by
  rw [Real.log_nat_eq_sum_factorization]
  rw [Finsupp.sum_of_support_subset (s := primesLE M)]
  · refine Finset.sum_congr rfl fun p hp => ?_
    rw [Nat.factorization_def _ (prime_of_mem_primesLE hp)]
  · intro q hq
    rw [Nat.support_factorization] at hq
    have hq' := Nat.prime_of_mem_primeFactors hq
    exact mem_primesLE.mpr ⟨h q hq' (Nat.dvd_of_mem_primeFactors hq), hq'⟩
  · intro i _; simp

lemma log_factorial_eq_sum (n : ℕ) : Real.log (n ! : ℝ) = ∑ k ∈ Icc 1 n, Real.log k := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [Finset.sum_Icc_succ_top (by omega), ← ih, Nat.factorial_succ, Nat.cast_mul,
      Real.log_mul (by positivity) (by positivity), add_comm]

theorem smooth_sum_le {n : ℕ} (S : Finset ℕ) (hS : S ⊆ Icc 1 n)
    (hsm : ∀ k ∈ S, ∀ q, q.Prime → q ∣ 1 + k ^ 2 → q ≤ 2 * n) :
    ∑ k ∈ S, Real.log (1 + (k : ℝ) ^ 2) ≤ ∑ p ∈ primesLE (2 * n), (V p n : ℝ) * Real.log p := by
  calc ∑ k ∈ S, Real.log (1 + (k : ℝ) ^ 2)
      = ∑ k ∈ S, ∑ p ∈ primesLE (2 * n), (padicValNat p (1 + k ^ 2) : ℝ) * Real.log p := by
        refine Finset.sum_congr rfl fun k hk => ?_
        have := log_eq_sum_primesLE (1 + k ^ 2) (2 * n) (by positivity) (hsm k hk)
        push_cast at this
        exact this
    _ = ∑ p ∈ primesLE (2 * n), ∑ k ∈ S, (padicValNat p (1 + k ^ 2) : ℝ) * Real.log p :=
        Finset.sum_comm
    _ ≤ ∑ p ∈ primesLE (2 * n), ∑ k ∈ Icc 1 n, (padicValNat p (1 + k ^ 2) : ℝ) * Real.log p := by
        refine Finset.sum_le_sum fun p hp => ?_
        refine Finset.sum_le_sum_of_subset_of_nonneg hS fun k _ _ => ?_
        have := Real.log_natCast_nonneg p
        positivity
    _ = _ := by
        refine Finset.sum_congr rfl fun p _ => ?_
        simp [V, Finset.sum_mul]
theorem two_log_factorial_le (n : ℕ) :
    2 * Real.log (n ! : ℝ) ≤ ∑ k ∈ Icc 1 n, Real.log (1 + (k : ℝ) ^ 2) := by
  rw [log_factorial_eq_sum, Finset.mul_sum]
  refine Finset.sum_le_sum fun k hk => ?_
  have hk1 : (1 : ℝ) ≤ k := by exact_mod_cast (Finset.mem_Icc.mp hk).1
  rw [← Real.log_rpow (by linarith)]
  apply Real.log_le_log (by positivity)
  norm_num
/-- Chebyshev/Legendre: m L(m) ≤ Real.log m! + θ(m). -/
theorem mul_L_le (m : ℕ) : (m : ℝ) * L m ≤ Real.log (m ! : ℝ) + Chebyshev.theta m := by
  rcases Nat.eq_zero_or_pos m with rfl | hm
  · simp [L, primesLE_zero]
  have hlog : Real.log (m ! : ℝ) = ∑ p ∈ primesLE m, (padicValNat p (m !) : ℝ) * Real.log p :=
    log_eq_sum_primesLE _ m (Nat.factorial_ne_zero m) (fun q hq hd => (hq.dvd_factorial).mp hd)
  rw [hlog, Chebyshev.theta_eq_sum_primesLE_log, L, Finset.mul_sum, ← Finset.sum_add_distrib]
  refine Finset.sum_le_sum fun p hp => ?_
  have hpp := prime_of_mem_primesLE hp
  have hpm := le_of_mem_primesLE hp
  haveI := Fact.mk hpp
  have hv : m / p ≤ padicValNat p (m !) := by
    rw [padicValNat_factorial (b := Nat.log p m + 1) (Nat.lt_succ_self _)]
    have h1 : 1 ≤ Nat.log p m := Nat.le_log_of_pow_le hpp.one_lt (by simpa using hpm)
    have : 1 ∈ Finset.Ico 1 (Nat.log p m + 1) := Finset.mem_Ico.mpr ⟨le_rfl, by omega⟩
    simpa using Finset.single_le_sum (f := fun i => m / p ^ i) (fun _ _ => Nat.zero_le _) this
  have hpR : (0 : ℝ) < p := by exact_mod_cast hpp.pos
  have hdiv : (m : ℝ) / p - 1 ≤ (m / p : ℕ) := by
    have h := Nat.lt_div_mul_add (a := m) hpp.pos
    have h' : (m : ℝ) < ((m / p : ℕ) : ℝ) * p + p := by exact_mod_cast h
    rw [sub_le_iff_le_add, div_le_iff₀ hpR]
    nlinarith
  have hv' : ((m / p : ℕ) : ℝ) ≤ padicValNat p (m !) := by exact_mod_cast hv
  have hl := Real.log_natCast_nonneg p
  have : (m : ℝ) * (Real.log p / p) = ((m : ℝ) / p) * Real.log p := by ring
  rw [this]
  nlinarith [hdiv, hv', hl]
/-- Stirling upper bound from Mathlib's stirlingSeq. -/
theorem log_factorial_le {m : ℕ} (hm : 1 ≤ m) :
    Real.log (m ! : ℝ) ≤ m * Real.log m - m + 1 + Real.log m / 2 := by
  have hm0 : (0 : ℝ) < m := by exact_mod_cast hm
  have h1 : Stirling.stirlingSeq m ≤ Stirling.stirlingSeq 1 := by
    obtain ⟨k, rfl⟩ : ∃ k, m = k + 1 := ⟨m - 1, by omega⟩
    exact Stirling.stirlingSeq'_antitone (Nat.zero_le k)
  have hpos : 0 < Stirling.stirlingSeq m := by
    obtain ⟨k, rfl⟩ : ∃ k, m = k + 1 := ⟨m - 1, by omega⟩
    exact Stirling.stirlingSeq'_pos k
  have h2 := Real.log_le_log hpos h1
  have hr : Real.log (Real.exp 1 / √2) = 1 - Real.log 2 / 2 := by
    rw [Real.log_div (by positivity) (by positivity), Real.log_exp, Real.log_sqrt (by norm_num)]
  rw [Stirling.log_stirlingSeq_formula, Stirling.stirlingSeq_one, hr,
    Real.log_mul (by norm_num) hm0.ne', Real.log_div hm0.ne' (by positivity), Real.log_exp] at h2
  nlinarith



