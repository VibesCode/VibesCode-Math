def okL (t : ℕ × ℕ × ℕ) : Bool :=
  decide (2 ≤ t.1) && decide (t.1 ≤ 20000) && decide (t.1 % 4 ≠ 1) && decide (2 ^ t.2.1 ≤ t.1 ^ 16) &&
