theorem mem_primesLE' {p m : ℕ} : p ∈ primesLE m ↔ p ≤ m ∧ p.Prime := mem_primesLE

theorem S1_le (m : ℕ) : S1 m ≤ L m - L3 m + T1 m := by
  have h1 : S1 m = (∑ p ∈ primesLE m with p % 4 = 1, Real.log p / p) + T1 m := by
    unfold S1 T1
    rw [← Finset.sum_add_distrib]
    apply Finset.sum_congr rfl
    intro p hp
    have hp2 : 2 ≤ p := (Finset.mem_filter.1 hp |>.1 |> mem_primesLE.1).2.two_le
    have h2 : (2:ℝ) ≤ p := by exact_mod_cast hp2
    have : (p:ℝ) - 1 ≠ 0 := by linarith
    have : (p:ℝ) ≠ 0 := by linarith
    field_simp
    ring
  have h2 : L m = L3 m + ∑ p ∈ primesLE m with p % 4 = 1, Real.log p / p := by
    unfold L L3
    rw [← Finset.sum_filter_add_sum_filter_not (primesLE m) (fun p => p % 4 = 1)]
    ring
  rw [h1, h2]; linarith

theorem L3_mono {a b : ℕ} (h : a ≤ b) : L3 a ≤ L3 b := by
  unfold L3
  apply Finset.sum_le_sum_of_subset_of_nonneg
  · intro p hp
    simp only [Finset.mem_filter, mem_primesLE] at hp ⊢
    exact ⟨⟨hp.1.1.trans h, hp.1.2⟩, hp.2⟩
  · intro p _ _
    exact div_nonneg (Real.log_natCast_nonneg p) (Nat.cast_nonneg p)

theorem finset_sum_le_list (l : List (ℕ × ℕ × ℕ)) (hnd : (l.map (·.1)).Nodup) (f : ℕ → ℝ)
    (c : ℕ × ℕ × ℕ → ℝ) (h : ∀ t ∈ l, f t.1 ≤ c t) :
    ∑ p ∈ (l.map (·.1)).toFinset, f p ≤ (l.map c).sum := by
  rw [List.sum_toFinset f hnd, List.map_map]
  clear hnd
  induction l with
  | nil => simp
  | cons t l ih =>
    simp only [List.map_cons, List.sum_cons, Function.comp]
    have := h t (by simp)
    have := ih (fun s hs => h s (by simp [hs]))
    linarith

theorem list_le_finset_sum (l : List (ℕ × ℕ × ℕ)) (hnd : (l.map (·.1)).Nodup) (f : ℕ → ℝ)
    (c : ℕ × ℕ × ℕ → ℝ) (h : ∀ t ∈ l, c t ≤ f t.1) :
    (l.map c).sum ≤ ∑ p ∈ (l.map (·.1)).toFinset, f p := by
  rw [List.sum_toFinset f hnd, List.map_map]
  clear hnd
  induction l with
  | nil => simp
  | cons t l ih =>
    simp only [List.map_cons, List.sum_cons, Function.comp]
    have := h t (by simp)
    have := ih (fun s hs => h s (by simp [hs]))
    linarith

theorem list_sum_const (l : List (ℕ × ℕ × ℕ)) (C D : ℝ) :
    (l.map (fun t => C * ((t.2.2 : ℝ) / D))).sum = C * (((l.map (·.2.2)).sum : ℕ) / D) := by
  induction l with
  | nil => simp
  | cons t l ih => simp only [List.map_cons, List.sum_cons, ih]; push_cast; ring

theorem okL_prime {t : ℕ × ℕ × ℕ} (h : okL t = true) : t.1.Prime := by
  simp only [okL, Bool.and_eq_true, decide_eq_true_eq, List.all_eq_true, List.mem_range,
    Bool.or_eq_true] at h
  obtain ⟨⟨⟨⟨⟨h2, h20⟩, _⟩, _⟩, _⟩, hd⟩ := h
  rw [Nat.prime_def_le_sqrt]
  refine ⟨h2, fun d hd2 hds hdv => ?_⟩
  have h1 : d * d ≤ t.1 := by
    have := Nat.sqrt_le' t.1
    calc d * d ≤ Nat.sqrt t.1 * Nat.sqrt t.1 := Nat.mul_le_mul hds hds
      _ ≤ t.1 := Nat.sqrt_le t.1
  have h3 : d < 142 := by nlinarith
  have := hd d h3
  rcases this with (h | h) | h
  · omega
  · omega
  · exact h (Nat.mod_eq_zero_of_dvd hdv)

theorem L3_ge : Real.log 2 * (6785251938 / 10 ^ 9) ≤ L3 20000 := by
  have hok : ∀ t ∈ dataL, okL t = true := by
    have := dataL_ok
    rw [List.all_eq_true] at this
    exact this
  have hnd : (dataL.map (·.1)).Nodup := List.isChain_iff_pairwise.1 dataL_sorted |>.imp (fun h => ne_of_lt h)
  have key : ∀ t ∈ dataL, Real.log 2 * ((t.2.2 : ℝ) / 10 ^ 9) ≤ Real.log t.1 / t.1 := by
    intro t ht
    have h := hok t ht
    have hp := okL_prime h
    simp only [okL, Bool.and_eq_true, decide_eq_true_eq] at h
    obtain ⟨⟨⟨⟨⟨h2, h20⟩, _⟩, hpow⟩, hab⟩, _⟩ := h
    have hp0 : (0:ℝ) < t.1 := by exact_mod_cast (by omega : 0 < t.1)
    have hpow' : ((2:ℝ) ^ t.2.1) ≤ (t.1:ℝ) ^ 16 := by exact_mod_cast hpow
    have hl : (t.2.1 : ℝ) * Real.log 2 ≤ 16 * Real.log t.1 := by
      have := Real.log_le_log (by positivity) hpow'
      rwa [Real.log_pow, Real.log_pow] at this
    have hab' : (t.2.2 : ℝ) * (16 * t.1) ≤ t.2.1 * 10 ^ 9 := by exact_mod_cast hab
    have hl2 : 0 < Real.log 2 := Real.log_pos (by norm_num)
    rw [mul_div_assoc', div_le_div_iff₀ (by positivity) hp0]
    have : (t.2.2 : ℝ) * (16 * t.1) * Real.log 2 ≤ t.2.1 * 10 ^ 9 * Real.log 2 :=
      mul_le_mul_of_nonneg_right hab' hl2.le
    nlinarith [mul_le_mul_of_nonneg_left hl (by norm_num : (0:ℝ) ≤ 10 ^ 9)]
  have h1 := list_le_finset_sum dataL hnd (fun p => Real.log p / p)
    (fun t => Real.log 2 * ((t.2.2 : ℝ) / 10 ^ 9)) key
  rw [list_sum_const, dataL_sum] at h1
  refine le_trans (by exact_mod_cast h1) ?_
  unfold L3
  apply Finset.sum_le_sum_of_subset_of_nonneg
  · intro p hp
    obtain ⟨t, ht, rfl⟩ := List.mem_map.1 (List.mem_toFinset.1 hp)
    have h := hok t ht
    have hp := okL_prime h
    simp only [okL, Bool.and_eq_true, decide_eq_true_eq] at h
    obtain ⟨⟨⟨⟨⟨h2, h20⟩, h4⟩, _⟩, _⟩, _⟩ := h
    simp only [Finset.mem_filter, mem_primesLE]
    exact ⟨⟨h20, hp⟩, h4⟩
  · intro p _ _
    exact div_nonneg (Real.log_natCast_nonneg p) (Nat.cast_nonneg p)

noncomputable def ff (x : ℕ) : ℝ := Real.log x / ((x : ℝ) * ((x : ℝ) - 1))

noncomputable def gg (t : ℝ) : ℝ := (Real.log t + 1) / t

theorem key_ineq (x : ℝ) (hx : 1001 ≤ x) :
    Real.log x / (x * (x - 1)) ≤ 2 * (gg (x - 1) - gg x) := by
  have hy : (1000:ℝ) ≤ x - 1 := by linarith
  have hy0 : 0 < x - 1 := by linarith
  have hx0 : 0 < x := by linarith
  have hlog : Real.log x ≤ Real.log (x - 1) + 1 / (x - 1) := by
    have := Real.log_le_sub_one_of_pos (show 0 < x / (x - 1) by positivity)
    rw [Real.log_div hx0.ne' hy0.ne'] at this
    have e : x / (x - 1) - 1 = 1 / (x - 1) := by field_simp; ring
    linarith
  have hL : 1 ≤ Real.log x := by
    have h3 : Real.exp 1 ≤ x := by
      have := Real.exp_one_lt_d9; linarith
    simpa using Real.log_le_log (Real.exp_pos 1) h3
  unfold gg
  have h1 : (Real.log x - 1 / (x - 1) + 1) / (x - 1) ≤ (Real.log (x - 1) + 1) / (x - 1) := by
    apply div_le_div_of_nonneg_right _ hy0.le; linarith
  have h2 : 2 * ((Real.log x - 1 / (x - 1) + 1) / (x - 1) - (Real.log x + 1) / x)
      - Real.log x / (x * (x - 1)) = ((Real.log x + 2) * (x - 1) - 2 * x) / (x * (x - 1) ^ 2) := by
    field_simp; ring
  have h3 : 0 ≤ ((Real.log x + 2) * (x - 1) - 2 * x) / (x * (x - 1) ^ 2) := by
    apply div_nonneg _ (by positivity)
    nlinarith
  linarith

theorem tail_bound (m : ℕ) (hm : 1000 ≤ m) :
    ∑ x ∈ Ioc 1000 m, ff x ≤ 2 * (gg 1000 - gg m) := by
  induction m, hm using Nat.le_induction with
  | base => simp
  | succ m hm ih =>
    rw [Finset.sum_Ioc_succ_top hm]
    have := key_ineq ((m + 1 : ℕ) : ℝ) (by
      have : (1000 : ℝ) ≤ m := by exact_mod_cast hm
      push_cast; linarith)
    have e : ((m + 1 : ℕ) : ℝ) - 1 = m := by push_cast; ring
    rw [e] at this
    unfold ff at *
    rw [e]
    linarith

theorem ff_nonneg (x : ℕ) : 0 ≤ ff x := by
  unfold ff
  rcases Nat.eq_zero_or_pos x with rfl | hx
  · simp
  · apply div_nonneg (Real.log_natCast_nonneg x)
    have : (1:ℝ) ≤ x := by exact_mod_cast hx
    nlinarith

theorem gg_nonneg (m : ℕ) : 0 ≤ gg m := by
  unfold gg
  rcases Nat.eq_zero_or_pos m with rfl | hx
  · simp
  · have := Real.log_natCast_nonneg m
    positivity

theorem gg1000 : gg 1000 ≤ (10 * Real.log 2 + 1) / 1000 := by
  unfold gg
  have : Real.log 1000 ≤ 10 * Real.log 2 := by
    have h := Real.log_le_log (by norm_num : (0:ℝ) < 1000) (by norm_num : (1000:ℝ) ≤ 2 ^ 10)
    rwa [Real.log_pow] at h
  push_cast
  apply div_le_div_of_nonneg_right _ (by norm_num)
  push_cast at this ⊢
  linarith

theorem partA : ∑ p ∈ (dataU.map (·.1)).toFinset, ff p
    ≤ Real.log 2 * (276251020 / 10 ^ 9) := by
  have hok : ∀ t ∈ dataU, okU t = true := by
    have := dataU_ok
    rw [List.all_eq_true] at this
    exact this
  have hnd : (dataU.map (·.1)).Nodup := List.isChain_iff_pairwise.1 dataU_sorted |>.imp (fun h => ne_of_lt h)
  have key : ∀ t ∈ dataU, ff t.1 ≤ Real.log 2 * ((t.2.2 : ℝ) / 10 ^ 9) := by
    intro t ht
    unfold ff
    have h := hok t ht
    simp only [okU, Bool.and_eq_true, decide_eq_true_eq] at h
    obtain ⟨⟨⟨⟨h5, _⟩, _⟩, hpow⟩, hab⟩ := h
    have hx : (5:ℝ) ≤ t.1 := by exact_mod_cast h5
    have hpow' : ((t.1:ℝ)) ^ 16 ≤ 2 ^ t.2.1 := by exact_mod_cast hpow.le
    have hl : 16 * Real.log t.1 ≤ (t.2.1 : ℝ) * Real.log 2 := by
      have := Real.log_le_log (by positivity) hpow'
      rwa [Real.log_pow, Real.log_pow] at this
    have hab' : (t.2.1 : ℝ) * 10 ^ 9 ≤ t.2.2 * (16 * t.1 * ((t.1 : ℝ) - 1)) := by
      have : ((t.1 - 1 : ℕ) : ℝ) = (t.1 : ℝ) - 1 := by
        rw [Nat.cast_sub (by omega)]; simp
      rw [← this]; exact_mod_cast hab
    have hl2 : 0 < Real.log 2 := Real.log_pos (by norm_num)
    have hd : 0 < (t.1 : ℝ) * ((t.1 : ℝ) - 1) := by nlinarith
    rw [mul_div_assoc', div_le_div_iff₀ hd (by positivity)]
    nlinarith [mul_le_mul_of_nonneg_left hl (by norm_num : (0:ℝ) ≤ 10 ^ 9),
      mul_le_mul_of_nonneg_right hab' hl2.le]
  have h1 := finset_sum_le_list dataU hnd ff
    (fun t => Real.log 2 * ((t.2.2 : ℝ) / 10 ^ 9)) key
  rw [list_sum_const, dataU_sum] at h1
  have e : ((10 ^ 9 : ℕ) : ℝ) = 10 ^ 9 := by norm_num
  simpa using h1

theorem T1_le (m : ℕ) : T1 m ≤ Real.log 2 * (276251020 / 10 ^ 9) + 2 * (10 * Real.log 2 + 1) / 1000 := by
  have hA := partA
  have hT : T1 m = ∑ p ∈ (primesLE m).filter (fun p => p % 4 = 1), ff p := rfl
  have hsub : (primesLE m).filter (fun p => p % 4 = 1) ⊆
      (dataU.map (·.1)).toFinset ∪ Ioc 1000 m := by
    intro p hp
    simp only [Finset.mem_filter, mem_primesLE] at hp
    obtain ⟨⟨hpm, hpp⟩, h4⟩ := hp
    rw [Finset.mem_union]
    by_cases h : p ≤ 1000
    · left
      have := hpp.two_le
      exact List.mem_toFinset.mpr (dataU_complete p (by omega) (by omega) h4)
    · right
      simp only [Finset.mem_Ioc]; omega
  have h1 : T1 m ≤ ∑ p ∈ (dataU.map (·.1)).toFinset ∪ Ioc 1000 m, ff p := by
    rw [hT]
    exact Finset.sum_le_sum_of_subset_of_nonneg hsub (fun p _ _ => ff_nonneg p)
  have h2 : ∑ p ∈ (dataU.map (·.1)).toFinset ∪ Ioc 1000 m, ff p ≤
      ∑ p ∈ (dataU.map (·.1)).toFinset, ff p + ∑ p ∈ Ioc 1000 m, ff p := by
    have := Finset.sum_union_inter (s₁ := (dataU.map (·.1)).toFinset) (s₂ := Ioc 1000 m) (f := ff)
    have h0 : 0 ≤ ∑ p ∈ (dataU.map (·.1)).toFinset ∩ Ioc 1000 m, ff p :=
      Finset.sum_nonneg (fun p _ => ff_nonneg p)
    linarith
  have hg := gg1000
  have hB : ∑ p ∈ Ioc 1000 m, ff p ≤ 2 * gg 1000 := by
    by_cases hm : 1000 ≤ m
    · have := tail_bound m hm
      have := gg_nonneg m
      linarith
    · have : Ioc 1000 m = ∅ := by
        rw [Finset.Ioc_eq_empty_iff]; omega
      rw [this]; simp only [Finset.sum_empty]
      have := gg_nonneg 1000
      simp only [Nat.cast_ofNat] at this
      linarith
  have : 2 * (10 * Real.log 2 + 1) / 1000 = 2 * ((10 * Real.log 2 + 1) / 1000) := by ring
  linarith


