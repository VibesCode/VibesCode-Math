/-- Lean-checked finite range: for 5 ≤ n ≤ 499950001250, an integer value forces n ∈ E. -/
theorem mem_exceptional_of_le (n : ℕ) (hn : 5 ≤ n) (hN : n ≤ 499950001250) (hI : IsIntegerValue n) :
    n ∈ exceptional := by
  rcases (show (5 ≤ n ∧ n ≤ 6) ∨ (7 ≤ n ∧ n ≤ 8) ∨ (9 ≤ n ∧ n ≤ 18) ∨ (19 ≤ n ∧ n ≤ 20) ∨ (21 ≤ n ∧ n ≤ 128) ∨ (129 ≤ n ∧ n ≤ 200) ∨ (201 ≤ n ∧ n ≤ 7938) ∨ (7939 ≤ n ∧ n ≤ 16928) ∨ (16929 ≤ n ∧ n ≤ 31284050) ∨ (31284051 ≤ n ∧ n ≤ 143244738) ∨ (143244739 ≤ n ∧ n ≤ 499950001250) by omega) with h | h | h | h | h | h | h | h | h | h | h
  · exact (TwoPrimes.mem_exceptional_of_two_primes (k₁ := 4) (k₂ := 5) hn p17 p13 (by norm_num) (by omega) (by omega) (by simp; omega) (by simp; omega) (by norm_num) (by norm_num) hI).1
  · exact (TwoPrimes.mem_exceptional_of_two_primes (k₁ := 4) (k₂ := 6) hn p17 p37 (by norm_num) (by omega) (by omega) (by simp; omega) (by simp; omega) (by norm_num) (by norm_num) hI).1
  · exact (TwoPrimes.mem_exceptional_of_two_primes (k₁ := 6) (k₂ := 9) hn p37 p41 (by norm_num) (by omega) (by omega) (by simp; omega) (by simp; omega) (by norm_num) (by norm_num) hI).1
  · exact (TwoPrimes.mem_exceptional_of_two_primes (k₁ := 9) (k₂ := 16) hn p41 p257 (by norm_num) (by omega) (by omega) (by simp; omega) (by simp; omega) (by norm_num) (by norm_num) hI).1
  · exact (TwoPrimes.mem_exceptional_of_two_primes (k₁ := 16) (k₂ := 20) hn p257 p401 (by norm_num) (by omega) (by omega) (by simp; omega) (by simp; omega) (by norm_num) (by norm_num) hI).1
  · exact (TwoPrimes.mem_exceptional_of_two_primes (k₁ := 20) (k₂ := 126) hn p401 p15877 (by norm_num) (by omega) (by omega) (by simp; omega) (by simp; omega) (by norm_num) (by norm_num) hI).1
  · exact (TwoPrimes.mem_exceptional_of_two_primes (k₁ := 126) (k₂ := 184) hn p15877 p33857 (by norm_num) (by omega) (by omega) (by simp; omega) (by simp; omega) (by norm_num) (by norm_num) hI).1
  · exact (TwoPrimes.mem_exceptional_of_two_primes (k₁ := 184) (k₂ := 7910) hn p33857 p62568101 (by norm_num) (by omega) (by omega) (by simp; omega) (by simp; omega) (by norm_num) (by norm_num) hI).1
  · exact (TwoPrimes.mem_exceptional_of_two_primes (k₁ := 7910) (k₂ := 16926) hn p62568101 p286489477 (by norm_num) (by omega) (by omega) (by simp; omega) (by simp; omega) (by norm_num) (by norm_num) hI).1
  · exact (TwoPrimes.mem_exceptional_of_two_primes (k₁ := 16926) (k₂ := 999950) hn p286489477 p999900002501 (by norm_num) (by omega) (by omega) (by simp; omega) (by simp; omega) (by norm_num) (by norm_num) hI).1
  · exact (TwoPrimes.mem_exceptional_of_two_primes (k₁ := 999950) (k₂ := 999960) hn p999900002501 p999920001601 (by norm_num) (by omega) (by omega) (by simp; omega) (by simp; omega) (by norm_num) (by norm_num) hI).1

/-- Conditional full statement: the only input not checked here is the analytic lemma H
(two primes > 2n among the 1 + k², k ≤ n), needed only beyond 499950001250. -/
theorem mem_exceptional_of_H
    (H : ∀ n : ℕ, 499950001251 ≤ n → ∃ k₁ k₂ p₁ p₂ : ℕ, p₁.Prime ∧ p₂.Prime ∧ p₁ ≠ p₂ ∧
      2 * n < p₁ ∧ 2 * n < p₂ ∧ k₁ ∈ Icc 1 n ∧ k₂ ∈ Icc 1 n ∧
      (p₁ : ℤ) ∣ 1 + (k₁ : ℤ) ^ 2 ∧ (p₂ : ℤ) ∣ 1 + (k₂ : ℤ) ^ 2) :
    ∀ n : ℕ, 5 ≤ n → IsIntegerValue n → n ∈ exceptional := by
  intro n hn hI
  by_cases hN : n ≤ 499950001250
  · exact mem_exceptional_of_le n hn hN hI
  · obtain ⟨k₁, k₂, p₁, p₂, a1, a2, a3, a4, a5, a6, a7, a8, a9⟩ := H n (by omega)
    exact (TwoPrimes.mem_exceptional_of_two_primes hn a1 a2 a3 a4 a5 a6 a7 a8 a9 hI).1

end Certs

